import express from 'express';
import cors from 'cors';
import dotenv from 'dotenv';
import fs from 'fs';
import path from 'path';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';

dotenv.config();

const app = express();
const PORT = process.env.PORT || 4000;
const JWT_SECRET = process.env.JWT_SECRET || 'dev-secret-key';
const DATA_PATH = path.join(process.cwd(), 'data', 'store.json');

app.use(cors());
app.use(express.json());

function ensureStore() {
  const dir = path.dirname(DATA_PATH);
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }

  if (!fs.existsSync(DATA_PATH)) {
    const initial = {
      users: [
        {
          id: 'demo-user',
          name: 'Raj',
          email: 'raj@vibeforge.ai',
          passwordHash: bcrypt.hashSync('password123', 10),
          plan: 'Pro',
          credits: 2100,
          projects: [
            {
              id: 'demo-project-1',
              title: 'AI founder story',
              prompt: 'AI is reshaping creator businesses.',
              status: 'Ready',
              duration: '00:45',
              channel: 'YouTube Shorts',
              accent: 'purple',
              createdAt: new Date().toISOString(),
            },
          ],
        },
      ],
    };

    fs.writeFileSync(DATA_PATH, JSON.stringify(initial, null, 2));
  }
}

function readStore() {
  ensureStore();
  return JSON.parse(fs.readFileSync(DATA_PATH, 'utf8'));
}

function writeStore(store) {
  fs.writeFileSync(DATA_PATH, JSON.stringify(store, null, 2));
}

function findUserByEmail(email) {
  const store = readStore();
  return store.users.find((user) => user.email.toLowerCase() === email.toLowerCase());
}

function authMiddleware(req, res, next) {
  const header = req.headers.authorization || '');
  const token = header.startsWith('Bearer ') ? header.slice(7) : null;

  if (!token) {
    return res.status(401).json({ message: 'Authentication required' });
  }

  try {
    const decoded = jwt.verify(token, JWT_SECRET);
    req.user = decoded;
    next();
  } catch (error) {
    return res.status(401).json({ message: 'Invalid token' });
  }
}

app.get('/api/health', (_, res) => {
  res.json({ ok: true, message: 'VibeForge API is running' });
});

app.post('/api/auth/register', async (req, res) => {
  const { name, email, password } = req.body || {};

  if (!name || !email || !password) {
    return res.status(400).json({ message: 'Name, email and password are required' });
  }

  const store = readStore();
  if (store.users.some((user) => user.email.toLowerCase() === email.toLowerCase())) {
    return res.status(409).json({ message: 'User already exists' });
  }

  const newUser = {
    id: cryptoId(),
    name,
    email,
    passwordHash: bcrypt.hashSync(password, 10),
    plan: 'Pro',
    credits: 2100,
    projects: [],
  };

  store.users.push(newUser);
  writeStore(store);

  const token = jwt.sign({ id: newUser.id, email: newUser.email, name: newUser.name }, JWT_SECRET, { expiresIn: '7d' });

  res.status(201).json({
    token,
    user: {
      id: newUser.id,
      name: newUser.name,
      email: newUser.email,
      plan: newUser.plan,
    },
  });
});

app.post('/api/auth/login', (req, res) => {
  const { email, password } = req.body || {};

  if (!email || !password) {
    return res.status(400).json({ message: 'Email and password are required' });
  }

  const user = findUserByEmail(email);
  if (!user) {
    return res.status(401).json({ message: 'Invalid credentials' });
  }

  const isMatch = bcrypt.compareSync(password, user.passwordHash);
  if (!isMatch) {
    return res.status(401).json({ message: 'Invalid credentials' });
  }

  const token = jwt.sign({ id: user.id, email: user.email, name: user.name }, JWT_SECRET, { expiresIn: '7d' });

  res.json({
    token,
    user: {
      id: user.id,
      name: user.name,
      email: user.email,
      plan: user.plan,
    },
  });
});

app.get('/api/projects', authMiddleware, (req, res) => {
  const store = readStore();
  const user = store.users.find((item) => item.id === req.user.id);

  if (!user) {
    return res.status(404).json({ message: 'User not found' });
  }

  res.json({ projects: user.projects || [] });
});

app.post('/api/projects', authMiddleware, (req, res) => {
  const { title, prompt, channel = 'YouTube Shorts', duration = '00:45' } = req.body || {};

  if (!title || !prompt) {
    return res.status(400).json({ message: 'Title and prompt are required' });
  }

  const store = readStore();
  const user = store.users.find((item) => item.id === req.user.id);

  const project = {
    id: cryptoId(),
    title,
    prompt,
    status: 'Ready',
    duration,
    channel,
    accent: 'purple',
    createdAt: new Date().toISOString(),
  };

  user.projects.unshift(project);
  writeStore(store);

  res.status(201).json({ project });
});

app.post('/api/generate', authMiddleware, async (req, res) => {
  const { prompt, template, name = 'Creator' } = req.body || {};

  if (!prompt || !prompt.trim()) {
    return res.status(400).json({ message: 'Prompt is required' });
  }

  const cleanPrompt = prompt.trim();
  const templateName = template || 'startup';

  let aiScript = `Create a ${templateName} style video for ${name}. Start strong with a hook, explain the value, and end with a clear CTA. Topic: ${cleanPrompt}`;

  if (process.env.OPENAI_API_KEY) {
    try {
      const openAiResponse = await fetch('https://api.openai.com/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${process.env.OPENAI_API_KEY}`,
        },
        body: JSON.stringify({
          model: 'gpt-4o-mini',
          messages: [
            {
              role: 'system',
              content: 'You create compelling short-form video scripts for AI content creators.',
            },
            {
              role: 'user',
              content: cleanPrompt,
            },
          ],
          temperature: 0.8,
        }),
      });

      if (openAiResponse.ok) {
        const result = await openAiResponse.json();
        aiScript = result.choices?.[0]?.message?.content || aiScript;
      }
    } catch (error) {
      console.warn('OpenAI generation unavailable; using fallback script.', error.message);
    }
  }

  const store = readStore();
  const user = store.users.find((item) => item.id === req.user.id);

  const generatedProject = {
    id: cryptoId(),
    title: buildTitle(cleanPrompt),
    prompt: cleanPrompt,
    script: aiScript,
    status: 'Ready',
    duration: '00:42',
    channel: 'YouTube Shorts',
    accent: 'purple',
    createdAt: new Date().toISOString(),
  };

  user.projects.unshift(generatedProject);
  writeStore(store);

  res.status(201).json({
    message: 'Video generation completed',
    script: aiScript,
    project: generatedProject,
  });
});

app.get('/api/billing', authMiddleware, (req, res) => {
  const store = readStore();
  const user = store.users.find((item) => item.id === req.user.id);

  const plan = {
    name: user.plan || 'Pro',
    price: user.plan === 'Scale' ? '$49' : user.plan === 'Free' ? '$0' : '$19',
    features: ['Unlimited projects', '4K export', 'AI voice clone'],
  };

  res.json({ plan });
});

function buildTitle(prompt) {
  const words = prompt.split(/\s+/).slice(0, 6).join(' ');
  return words.length > 36 ? `${words.slice(0, 33)}...` : words;
}

function cryptoId() {
  return `${Date.now()}-${Math.random().toString(16).slice(2, 10)}`;
}

app.listen(PORT, () => {
  console.log(`VibeForge API listening on http://localhost:${PORT}`);
});

export default app;
