:root {
  --bg: #070b17;
  --bg-soft: #0b1221;
  --panel: rgba(17, 24, 39, 0.92);
  --panel-2: rgba(15, 23, 42, 0.74);
  --card: rgba(13, 18, 28, 0.9);
  --line: rgba(148, 163, 184, 0.15);
  --text: #edf4ff;
  --muted: #a7b4c8;
  --purple: #8b5cf6;
  --purple-soft: #d8c3ff;
  --cyan: #22d3ee;
  --green: #34d399;
  --orange: #f59e0b;
  --danger: #fb7185;
  --shadow: 0 28px 100px rgba(2, 6, 23, 0.72);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(139, 92, 246, 0.2), transparent 28%),
    radial-gradient(circle at right, rgba(34, 211, 238, 0.12), transparent 26%),
    var(--bg);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}

.page-shell {
  min-height: 100vh;
}

.container {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(14px);
  background: rgba(7, 11, 23, 0.6);
  border-bottom: 1px solid rgba(148, 163, 184, 0.08);
}

.nav-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82px;
  gap: 20px;
}

.brand-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--purple), var(--cyan));
  font-weight: 800;
  color: white;
  box-shadow: 0 16px 28px rgba(139, 92, 246, 0.38);
}

.brand-name {
  font-weight: 800;
  font-size: 1.1rem;
}

.main-nav,
.nav-actions,
.footer-links {
  display: flex;
  align-items: center;
  gap: 22px;
}

.main-nav a,
.nav-link-btn,
.footer-links a {
  color: var(--muted);
  font-size: 0.95rem;
}

.nav-link-btn,
.ghost-btn {
  background: transparent;
  border: 1px solid rgba(148, 163, 184, 0.2);
  color: var(--text);
  border-radius: 12px;
  padding: 10px 16px;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.primary-btn {
  border: none;
  background: linear-gradient(135deg, var(--purple), var(--cyan));
  color: #fff;
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
  box-shadow: 0 18px 34px rgba(139, 92, 246, 0.26);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.large {
  padding: 15px 22px;
  font-size: 1rem;
}

.primary-btn:hover,
.ghost-btn:hover,
.nav-link-btn:hover {
  transform: translateY(-1px);
}

.hero-section {
  padding: 80px 0 48px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 42px;
}

.eyebrow {
  display: inline-block;
  background: rgba(139, 92, 246, 0.12);
  color: var(--purple-soft);
  border: 1px solid rgba(139, 92, 246, 0.2);
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 0.72rem;
  letter-spacing: 0.12rem;
  text-transform: uppercase;
  font-weight: 700;
}

.hero-copy h1 {
  margin: 18px 0 14px;
  font-size: clamp(2.8rem, 6vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
  max-width: 650px;
}

.hero-copy p {
  margin: 0;
  max-width: 620px;
  color: var(--muted);
  font-size: 1.12rem;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 28px;
  flex-wrap: wrap;
}

.trust-row {
  margin-top: 30px;
  color: var(--muted);
  font-size: 0.82rem;
}

.logo-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 18px;
  color: #dfeaf8;
  opacity: 0.83;
  font-weight: 600;
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.mockup-window {
  position: relative;
  width: min(100%, 530px);
  padding: 22px 18px 20px;
  background: rgba(15, 23, 42, 0.88);
  border: 1px solid var(--line);
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.window-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 18px;
}

.dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  display: block;
}

.dot.red { background: #ff5f57; }
.dot.yellow { background: #ffbd2e; }
.dot.green { background: #28c840; }

.mockup-card {
  background: linear-gradient(180deg, rgba(17, 24, 39, 0.94), rgba(10, 15, 26, 0.94));
  border-radius: 24px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  padding: 20px;
}

.mini-tag {
  display: inline-block;
  background: rgba(34, 211, 238, 0.12);
  color: #b6f7ff;
  border: 1px solid rgba(34, 211, 238, 0.18);
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 0.7rem;
  letter-spacing: 0.08rem;
  text-transform: uppercase;
}

.mockup-card h3 {
  margin: 18px 0 10px;
  font-size: clamp(1.5rem, 4vw, 2.2rem);
  line-height: 1.12;
}

.mockup-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.mini-panel {
  margin-top: 22px;
  padding: 18px;
  background: rgba(8, 15, 27, 0.9);
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.12);
}

.panel-line {
  height: 12px;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(139, 92, 246, 0.7), rgba(34, 211, 238, 0.45));
  margin-bottom: 12px;
}

.panel-line.short { width: 42%; }
.panel-line.medium { width: 78%; }

.meta-row {
  margin-top: 18px;
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 0.8rem;
}

.floating-badge {
  position: absolute;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 14px;
  border-radius: 999px;
  font-weight: 700;
  border: 1px solid rgba(148, 163, 184, 0.15);
  background: rgba(9, 14, 25, 0.9);
  box-shadow: var(--shadow);
}

.floating-badge.one {
  right: -18px;
  top: 120px;
  color: #d8c3ff;
}

.floating-badge.two {
  left: -20px;
  bottom: 38px;
  color: #baf2ff;
}

.stat-band {
  padding: 18px 0 26px;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.metric-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 22px 18px;
  background: rgba(17, 24, 39, 0.7);
  border: 1px solid var(--line);
  border-radius: 18px;
}

.metric-box strong {
  font-size: clamp(1.7rem, 3vw, 2.3rem);
  letter-spacing: -0.04em;
}

.metric-box span {
  color: var(--muted);
}

.section-block {
  padding: 56px 0;
}

.section-block.alt {
  background: rgba(11, 18, 33, 0.75);
  border-top: 1px solid rgba(148, 163, 184, 0.08);
  border-bottom: 1px solid rgba(148, 163, 184, 0.08);
}

.section-heading {
  margin-bottom: 28px;
  text-align: center;
}

.section-heading.left {
  text-align: left;
}

.section-heading h2 {
  margin: 16px auto 0;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.08;
  letter-spacing: -0.05em;
  max-width: 700px;
}

.section-heading.left h2 {
  margin-left: 0;
}

.feature-grid,
.template-grid,
.testimonials-grid,
.pricing-grid {
  display: grid;
  gap: 18px;
}

.feature-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.feature-card,
.template-card,
.testimonial-card,
.pricing-card {
  background: rgba(17, 24, 39, 0.8);
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: 0 18px 40px rgba(2, 6, 23, 0.28);
}

.feature-card {
  padding: 22px 20px;
}

.feature-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: rgba(139, 92, 246, 0.12);
  color: var(--purple-soft);
  font-size: 1.3rem;
  margin-bottom: 16px;
}

.feature-card h3,
.template-card h3,
.pricing-card h3 {
  margin: 0 0 10px;
  font-size: 1.25rem;
}

.feature-card p,
.template-card p,
.pricing-card li,
.testimonial-card p {
  color: var(--muted);
  line-height: 1.7;
}

.workflow-wrap {
  display: grid;
  gap: 26px;
}

.workflow-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.workflow-step {
  background: rgba(17, 24, 39, 0.7);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 22px 18px;
}

.step-number {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.18), rgba(34, 211, 238, 0.12));
  color: var(--purple-soft);
  font-weight: 800;
  margin-bottom: 16px;
}

.workflow-step p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.template-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.template-card {
  padding: 22px 18px;
  position: relative;
  overflow: hidden;
  min-height: 180px;
}

.template-orb {
  width: 130px;
  height: 130px;
  border-radius: 50%;
  position: absolute;
  right: -28px;
  top: -14px;
  opacity: 0.38;
  filter: blur(10px);
}

.template-card.purple .template-orb {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.72), rgba(168, 85, 247, 0.28));
}

.template-card.cyan .template-orb {
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.72), rgba(59, 130, 246, 0.3));
}

.template-card.green .template-orb {
  background: linear-gradient(135deg, rgba(52, 211, 153, 0.7), rgba(16, 185, 129, 0.28));
}

.template-card.orange .template-orb {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.7), rgba(251, 146, 60, 0.28));
}

.template-card h3,
.template-card p {
  position: relative;
  z-index: 1;
}

.testimonials-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.testimonial-card {
  padding: 24px 20px;
}

.stars {
  color: #fbbf24;
  letter-spacing: 0.14rem;
  margin-bottom: 8px;
}

.author-row {
  margin-top: 18px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--purple), var(--cyan));
  font-weight: 800;
}

.author-row strong {
  display: block;
  margin-bottom: 4px;
}

.author-row span {
  color: var(--muted);
  font-size: 0.8rem;
}

.pricing-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.pricing-card {
  padding: 22px 20px 18px;
  position: relative;
}

.pricing-card.featured {
  background: linear-gradient(180deg, rgba(91, 72, 154, 0.2), rgba(17, 24, 39, 0.9));
  border-color: rgba(139, 92, 246, 0.35);
}

.badge {
  position: absolute;
  right: 20px;
  top: 18px;
  background: rgba(139, 92, 246, 0.14);
  color: var(--purple-soft);
  border: 1px solid rgba(139, 92, 246, 0.22);
  border-radius: 999px;
  font-size: 0.72rem;
  padding: 6px 10px;
}

.plan-description {
  margin: 0 0 12px;
  color: var(--muted);
}

.price-wrap {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 18px;
}

.price-wrap strong {
  font-size: 2.5rem;
  letter-spacing: -0.06em;
}

.price-wrap span {
  color: var(--muted);
}

.pricing-card ul {
  list-style: none;
  margin: 0 0 18px;
  padding: 0;
  display: grid;
  gap: 10px;
}

.pricing-card li {
  position: relative;
  padding-left: 22px;
}

.pricing-card li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: #7dd3fc;
}

.full {
  width: 100%;
}

.site-footer {
  padding: 24px 0 60px;
}

.footer-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid rgba(148, 163, 184, 0.08);
  padding-top: 22px;
}

@media (max-width: 980px) {
  .hero-grid,
  .feature-grid,
  .template-grid,
  .workflow-grid,
  .testimonials-grid,
  .pricing-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-grid {
    grid-template-columns: 1fr;
  }

  .main-nav {
    display: none;
  }
}

@media (max-width: 640px) {
  .nav-wrap,
  .nav-actions,
  .footer-wrap {
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-actions,
  .footer-links {
    width: 100%;
    justify-content: space-between;
  }

  .feature-grid,
  .template-grid,
  .workflow-grid,
  .testimonials-grid,
  .pricing-grid,
  .stat-grid {
    grid-template-columns: 1fr;
  }

  .hero-copy h1 {
    font-size: 2.8rem;
  }

  .hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .primary-btn,
  .ghost-btn,
  .nav-link-btn {
    width: 100%;
  }

  .floating-badge {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}

#root {
  min-height: 100vh;
}
